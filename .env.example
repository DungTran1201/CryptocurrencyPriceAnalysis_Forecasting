# ==============================================================================
# Real-Time Financial Data Intelligence Platform — Environment Configuration
# ==============================================================================

# Adaptive Execution Profile: lite | standard | extended
PLATFORM_PROFILE=lite
APP_ENV=development
DEBUG=false
LOG_FORMAT=text
APP_NAME="Binance Real-Time Financial Intelligence Platform"
APP_VERSION=3.0.0

# Database Connection Strings
# Profile LITE default (SQLite WAL under ./data/)
DATABASE_URL="sqlite+aiosqlite:///./data/crypto_market.db"
SYNC_DATABASE_URL="sqlite:///./data/crypto_market.db"

# Profile STANDARD / EXTENDED PostgreSQL example (psycopg v3 sync driver):
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/crypto_forecasting"
# SYNC_DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/crypto_forecasting"

# Streaming & NATS JetStream Broker
STREAM_ENABLED=true
BROKER_BACKEND=nats
NATS_URL="nats://127.0.0.1:4222"
# STREAM_SYMBOLS="BTCUSDT,ETHUSDT"
# STREAM_STREAMS="aggTrade,kline_1m"

# Hot State Cache & Persistent DuckDB Warehouse (IFC-DP-011)
HOT_STATE_BACKEND=nats_kv
WAREHOUSE_ENABLED=true
WAREHOUSE_DIR="./data/warehouse"
WORKFLOW_POLL_INTERVAL_SEC=2.0

# Medallion Storage Backend: local | s3
STORAGE_BACKEND=local
DATA_DIR="./data"
# S3_ENDPOINT_URL="http://localhost:9000"
# S3_BUCKET="crypto-lakehouse"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# Allowed CORS Origins (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:8000"]

# Binance Public Endpoints (No API key needed for public market data)
BINANCE_API_URL="https://data-api.binance.vision/api/v3/klines"
BINANCE_FALLBACK_URL="https://api.binance.com/api/v3/klines"
BINANCE_WS_URL="wss://data-stream.binance.vision:9443"
BINANCE_WS_FALLBACK_URL="wss://stream.binance.com:9443"

# Optional Admin Token for mutation endpoints in non-localhost deployments
# ADMIN_API_TOKEN=""

# Optional MLflow Experiment Tracking Server
MLFLOW_TRACKING_URI=""
