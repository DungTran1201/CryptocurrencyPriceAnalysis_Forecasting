# ==============================================================================
# Binance Crypto Intelligence & Forecasting Platform — Environment Configuration
# ==============================================================================

# Application Environment (development, production, testing)
APP_ENV=development
DEBUG=false
APP_NAME="Binance Crypto Intelligence & Forecasting System"
APP_VERSION=2.0.0

# Database Connection Strings
# Default local SQLite database (created automatically under ./data/)
DATABASE_URL="sqlite+aiosqlite:///./data/crypto_market.db"
SYNC_DATABASE_URL="sqlite:///./data/crypto_market.db"

# Production PostgreSQL Example (Optional):
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/crypto_market"
# SYNC_DATABASE_URL="postgresql://user:password@localhost:5432/crypto_market"

# Allowed CORS Origins (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:8000"]

# Binance Public API Endpoints (No API key needed for public market data)
BINANCE_API_URL="https://data-api.binance.vision/api/v3/klines"
BINANCE_FALLBACK_URL="https://api.binance.com/api/v3/klines"

# MLflow Experiment Tracking (Optional remote tracking server)
# Leave blank to use local fallback registry
MLFLOW_TRACKING_URI=""
